# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram Bot Integration
# 1. Создайте бота в @BotFather и вставьте токен:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# 2. ID чата или группы (можно несколько через запятую: -100123456789,987654321):
TELEGRAM_CHAT_ID=-1001234567890

# Vercel Cron Security Secret (optional)
CRON_SECRET=your_random_secret_string

# iiko Cloud API (опционально, если подключается интеграция с кассой)
IIKO_API_LOGIN=your_iiko_api_login
IIKO_ORGANIZATION_ID=your_organization_id
IIKO_TERMINAL_GROUP_ID=your_terminal_group_id
